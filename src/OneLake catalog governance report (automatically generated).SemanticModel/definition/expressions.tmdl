		                		{"Item ID",          "Tags",         "Description", "Item name",   "artifactTypeIDPBI", "artifactSubType", "Workspace ID",      "Workspace name", "artifact", "Last visited time",  "Discoverability", "artifactEndorsement", "artifactInformationProtection", "dataDomainArtifactInfo", "lastRefreshTimeEpoc", "workspaceType"})
				        ,#"Expanded artifact" = Table.ExpandRecordColumn(#"Expanded Column1", "artifact",
