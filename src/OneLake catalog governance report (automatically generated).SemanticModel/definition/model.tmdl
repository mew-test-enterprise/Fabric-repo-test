model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Fact

	annotation PBI_QueryGroupOrder = 0

queryGroup Measures

	annotation PBI_QueryGroupOrder = 1

annotation PBI_QueryOrder = ["Host","All Item - Data Owner","PowerBIArtifacts","Measure","ActionsMeasures","VisualsEmptyStateMeasures","DataArtifacts","InsightArtifacts","ProcessArtifacts","SolutionsArtifacts","ConfigurationsArtifacts","DataSharesStats"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table 'All Item - Data Owner'
ref table Measure
ref table ActionsMeasures
ref table VisualsEmptyStateMeasures
ref table DataSharesStats

ref cultureInfo en-US

