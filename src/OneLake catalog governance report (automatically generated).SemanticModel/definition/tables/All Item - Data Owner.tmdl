	column 'Refresh groups' =
			
			IF(
			    ISBLANK('All Item - Data Owner'[Months from last refresh]),
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        'All Item - Data Owner'[Months from last refresh] = 0 || 'All Item - Data Owner'[Months from last refresh] = 1, "Last month",
			        'All Item - Data Owner'[Months from last refresh] >= 2 && 'All Item - Data Owner'[Months from last refresh] <= 4, "2-4 months",
			        'All Item - Data Owner'[Months from last refresh] > 4, "> 4 months"
			    )
			)
		lineageTag: 0ccc44bd-b5db-472e-8d4c-022aa2144202
		summarizeBy: none
		sortByColumn: 'Refresh groups sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Refresh groups sort' =
			
			IF(
			    ISBLANK('All Item - Data Owner'[Months from last refresh]),
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        'All Item - Data Owner'[Months from last refresh] = 0 || 'All Item - Data Owner'[Months from last refresh] = 1, 1,
			        'All Item - Data Owner'[Months from last refresh] >= 2 && 'All Item - Data Owner'[Months from last refresh] <= 4, 2,
			        'All Item - Data Owner'[Months from last refresh] > 4, 3
			    )
			)
		formatString: 0
		lineageTag: 5c421913-17f2-4c14-b088-2a329230ac0a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Visit groups' =
			
