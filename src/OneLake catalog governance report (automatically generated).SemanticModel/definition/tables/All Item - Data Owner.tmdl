	column 'Hierarchy parent domain name' = ```
			
			    IF(
			        ISBLANK('All Item - Data Owner'[ParentDomainName]), 
			        IF(
			            ISBLANK('All Item - Data Owner'[DomainName]), 
			            "No domain",  // If both DomainName and ParentDomainName are blank, assign "No domain"
			            'All Item - Data Owner'[DomainName]  // Otherwise, assign the domain name
			        ), 
			        'All Item - Data Owner'[ParentDomainName] // If ParentDomainName is not blank, assign it
			    )
			```
		lineageTag: 5b4e5884-b3a0-4bbd-be30-63213d3bba51
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Hierarchy sub domain name' = ```
			
			    IF(
			        ISBLANK('All Item - Data Owner'[ParentDomainName]), 
			        "", 
			        'All Item - Data Owner'[DomainName]
			    )
			```
		lineageTag: acf3f425-dcb8-4df9-a865-a09774d05091
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Hierarchy parent domain id' = ```
			
			    IF(
			        ISBLANK('All Item - Data Owner'[ParentDomainObjectId]), 
			        IF(
			            ISBLANK('All Item - Data Owner'[DomainObjectId]), 
			            BLANK(),  // If both DomainObjectId and ParentDomainObjectId are blank, assign Blank
			            'All Item - Data Owner'[DomainObjectId]  // Otherwise, assign the domain id
			        ), 
			        'All Item - Data Owner'[ParentDomainObjectId] // If ParentDomainObjectId is not blank, assign it
			    )
			
			
			```
		lineageTag: ee7c138a-0f52-484e-983f-5b8072ce2aa5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Hierarchy sub domain id' = ```
			
			    IF(
			        ISBLANK('All Item - Data Owner'[ParentDomainObjectId]), 
			        BLANK(), 
			        'All Item - Data Owner'[DomainObjectId]
			    )
			```
		lineageTag: b83ddc8c-d9ac-4f5c-b642-7c930bc67b79
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsSharedExternally = IF(ISBLANK(RELATED(DataSharesStats[Item ID])), false, true)
